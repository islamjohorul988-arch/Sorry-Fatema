<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sorry Fatema</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
}

body {
    font-family: Arial, sans-serif;
}

.scene {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;

    background:
        radial-gradient(circle at center,
        #11131c 0%,
        #050509 45%,
        #000 100%);
}

/* Falling words */
.word {
    position: absolute;
    top: -120px;

    color: white;
    white-space: nowrap;

    font-weight: 300;
    letter-spacing: 1px;

    text-shadow:
        0 0 5px white,
        0 0 12px #dff8ff,
        0 0 25px #71ddff,
        0 0 45px #35cfff;

    animation-name: fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;

    pointer-events: none;
}

/* TOP → BOTTOM */
@keyframes fall {

    0% {
        transform:
            translateY(-150px)
            rotate(var(--rotate))
            scale(var(--scale));

        opacity: 0;
    }

    8% {
        opacity: 1;
    }

    90% {
        opacity: 1;
    }

    100% {
        transform:
            translateY(120vh)
            rotate(var(--rotate))
            scale(var(--scale));

        opacity: 0;
    }
}

/* Red hearts */
.sad {
    position: absolute;
    top: -100px;

    color: #ff2020;
    font-size: 45px;

    filter:
        drop-shadow(0 0 8px red)
        drop-shadow(0 0 25px red);

    animation: heartFall linear infinite;

    pointer-events: none;
}

@keyframes heartFall {

    0% {
        transform: translateY(-100px) scale(.7);
        opacity: 0;
    }

    10% {
        opacity: 1;
    }

    90% {
        opacity: 1;
    }

    100% {
        transform: translateY(120vh) scale(1.2);
        opacity: 0;
    }
}

/* Center message */
.center {
    position: absolute;

    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    z-index: 50;

    text-align: center;

    color: white;

    font-size: clamp(28px, 6vw, 65px);

    font-weight: bold;

    text-shadow:
        0 0 8px white,
        0 0 20px #6bdfff,
        0 0 45px #25cfff;

    animation: glow 2s ease-in-out infinite alternate;
}

@keyframes glow {

    from {
        opacity: .7;
        transform: translate(-50%, -50%) scale(.95);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1.05);
    }
}
</style>
</head>

<body>

<div class="scene" id="scene">

    <div class="center">
        Sorry Fatema 🥹❤️‍🩹
    </div>

</div>

<script>

const scene = document.getElementById("scene");

const words = 35;

/* Create falling words */

for (let i = 0; i < words; i++) {

    const word = document.createElement("div");

    word.className = "word";

    word.innerHTML = "Sorry Fatema";

    /* Random horizontal position */
    word.style.left =
        (Math.random() * 110 - 5) + "%";

    /* Different sizes */
    const size =
        16 + Math.random() * 38;

    word.style.fontSize = size + "px";

    /* Different rotation */
    const rotation =
        (Math.random() * 40 - 20);

    word.style.setProperty(
        "--rotate",
        rotation + "deg"
    );

    /* Different scale */
    const scale =
        0.7 + Math.random() * 0.7;

    word.style.setProperty(
        "--scale",
        scale
    );

    /* Different falling speed */
    const speed =
        3 + Math.random() * 5;

    word.style.animationDuration =
        speed + "s";

    /* Different starting time */
    word.style.animationDelay =
        (-Math.random() * 8) + "s";

    scene.appendChild(word);
}


/* Falling hearts */

for (let i = 0; i < 10; i++) {

    const heart = document.createElement("div");

    heart.className = "sad";

    heart.innerHTML = "🥹";

    heart.style.left =
        Math.random() * 100 + "%";

    heart.style.fontSize =
        (25 + Math.random() * 45) + "px";

    heart.style.animationDuration =
        (4 + Math.random() * 5) + "s";

    heart.style.animationDelay =
        (-Math.random() * 8) + "s";

    scene.appendChild(sad);
}

</script>

</body>
</html>
